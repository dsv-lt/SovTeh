# Универсальный шлюз к любой LLM по API (Google AI Studio, Groq, OpenRouter, OpenAI, GigaChat, Ollama/vLLM)
# Автоопределение провайдера по префиксу ключа при LLM_PROVIDER=auto:
#   AQ.... / AIza... -> Google AI Studio (Gemini)
#   gsk_...          -> Groq Cloud
#   sk-or-...        -> OpenRouter
#   sk-...           -> OpenAI
# Либо используйте провайдер-специфичные переменные: GEMINI_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY, GIGACHAT_CREDENTIALS
LLM_API_KEY=your_api_key_here
LLM_PROVIDER=auto

# Необязательные переопределения любой модели и эндпоинта:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_AUTO_DISCOVER_MODELS=true
# LLM_TIMEOUT=25.0
# LLM_MAX_TOKENS=1024

# Сетевой иммунитет (обход системных прокси/VPN/перехватчиков Windows)
BYPASS_SYSTEM_PROXY=true

# Локальные модели, датасет сюжетов и RAG
CLASSIFIER_BACKEND=lora
RAG_EMBEDDING_BACKEND=auto
DEVICE=auto
